# ProxySQL Web UI configuration  (/etc/proxysql-webui/config.ini)
# Keep this file root:proxysql-webui 0640 - it contains ProxySQL admin credentials.

[webui]
# Random string used to sign session cookies. The installer generates one.
secret_key = CHANGE_ME
data_dir = /var/lib/proxysql-webui
session_lifetime_minutes = 480
# Set to false only if you serve the UI over plain HTTP (not recommended)
secure_cookies = true
# Lock a username / client IP after N failed logins for lockout_minutes
max_login_failures = 5
lockout_minutes = 15
# Set to true when the UI runs behind a reverse proxy (nginx/httpd) on this host
behind_proxy = false

[service]
# Control of the local ProxySQL systemd unit (start/stop/restart, logs)
enabled = true
unit = proxysql
log_file = /var/lib/proxysql/proxysql.log
# Privileged commands run through sudo with the exact arguments allowed in
# /etc/sudoers.d/proxysql-webui (generated by the installer)
use_sudo = true

# One section per ProxySQL instance: [instance:<key>]
# NOTE: ProxySQL's default "admin" account only accepts connections from localhost.
# For remote instances add a second account to admin-admin_credentials, e.g.
#   UPDATE global_variables SET variable_value='admin:admin;radmin:S3cret'
#     WHERE variable_name='admin-admin_credentials';
#   LOAD ADMIN VARIABLES TO RUNTIME; SAVE ADMIN VARIABLES TO DISK;
[instance:local]
label = Local ProxySQL
host = 127.0.0.1
port = 6032
user = admin
password = admin
# true = this instance runs on the web UI host (service control applies to it)
local = true
connect_timeout = 5
read_timeout = 30

#[instance:proxysql2]
#label = ProxySQL node 2
#host = 10.0.0.12
#port = 6032
#user = radmin
#password = S3cret
#local = false
